<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/hanko" />
            <corners android:radius="7dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1.5dp"
                android:color="@color/ink_950" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</layer-list>
