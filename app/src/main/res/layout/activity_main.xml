<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.aniga.ui.widget.SakuraView
            android:id="@+id/sakura"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/tab_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/status_scrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#E615120F" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/global_chat"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:contentDescription="@string/people_global"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:text="@string/chat_mark"
            android:textColor="@color/paper_100"
            android:textSize="18sp"
            app:backgroundTint="@color/hanko"
            app:cornerRadius="28dp" />
    </FrameLayout>

    <com.example.aniga.ui.widget.InkNavView
        android:id="@+id/ink_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
