<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.aniga.ui.widget.SakuraView
            android:id="@+id/sakura"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <FrameLayout
            android:id="@+id/tab_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/status_scrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="#E615120F" />
    </FrameLayout>

    <com.example.aniga.ui.widget.InkNavView
        android:id="@+id/ink_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
