<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="460dp"
                android:clipChildren="false">

                <View
                    android:id="@+id/header_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:id="@+id/banner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.22"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <com.example.aniga.ui.widget.SpeedLinesView
                    android:id="@+id/speed"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <com.example.aniga.ui.widget.SeigaihaView
                    android:id="@+id/waves"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_gravity="bottom"
                    android:alpha="0.28" />

                <View
                    android:id="@+id/header_fade"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_gravity="bottom" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/cover"
                    android:layout_width="184dp"
                    android:layout_height="276dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="84dp"
                    android:elevation="18dp"
                    android:padding="4dp"
                    android:rotation="-3"
                    android:scaleType="centerCrop"
                    android:transitionName="cover"
                    app:shapeAppearance="@style/ShapeAppearance.Aniga.Cover"
                    app:strokeColor="@color/paper_100"
                    app:strokeWidth="8dp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-36dp"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="32dp">

                <TextView
                    android:id="@+id/type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Aniga.Kicker" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:lineSpacingMultiplier="0.92"
                    android:textAppearance="@style/TextAppearance.Aniga.Display"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/stats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.Aniga.Meta"
                    android:textColor="@color/paper_300" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/genres"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:chipSpacingVertical="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/detail_story"
                    android:textAppearance="@style/TextAppearance.Aniga.Kicker" />

                <TextView
                    android:id="@+id/synopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.Aniga.Body"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/facts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingMultiplier="1.3"
                    android:textAppearance="@style/TextAppearance.Aniga.Meta"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/shelf_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_field"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/detail_shelf"
                        android:textAppearance="@style/TextAppearance.Aniga.Headline"
                        android:textSize="20sp" />

                    <com.example.aniga.ui.shelf.ShelfPanel
                        android:id="@+id/shelf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gallery_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/detail_gallery"
                    android:textAppearance="@style/TextAppearance.Aniga.Kicker"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/gallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-20dp"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="20dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/cast_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/detail_cast"
                    android:textAppearance="@style/TextAppearance.Aniga.Kicker"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/cast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-20dp"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="20dp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/chapters_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chapters_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/detail_chapters"
                        android:textAppearance="@style/TextAppearance.Aniga.Headline" />

                    <TextView
                        android:id="@+id/chapter_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:textAppearance="@style/TextAppearance.Aniga.Meta" />
                </LinearLayout>

                <View
                    android:id="@+id/chapter_rule"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp" />

                <HorizontalScrollView
                    android:id="@+id/source_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/source_chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/read_controls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/read_start"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/detail_read_start"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/read_latest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/detail_read_latest"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/read_jump"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/detail_read_jump"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.example.aniga.ui.widget.StatusView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/chapters"
                    android:layout_width="match_parent"
                    android:layout_height="420dp"
                    android:background="@color/ink_900"
                    android:fadeScrollbars="false"
                    android:nestedScrollingEnabled="true"
                    android:overScrollMode="never"
                    android:paddingEnd="4dp"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/chapters_more"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:textAppearance="@style/TextAppearance.Aniga.Kicker"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/similar_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/detail_similar"
                    android:textAppearance="@style/TextAppearance.Aniga.Headline"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/similar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="-20dp"
                    android:layout_marginTop="10dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="20dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_round_scrim"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_back"
        app:tint="@color/paper_100" />

    <ImageButton
        android:id="@+id/share"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="end"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_round_scrim"
        android:contentDescription="@string/detail_share"
        android:src="@drawable/ic_share"
        app:tint="@color/paper_100" />
</FrameLayout>
